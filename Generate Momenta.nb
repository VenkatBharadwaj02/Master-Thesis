Cell[BoxData[
 RowBox[{
  RowBox[{"genmom", "[", "n_", "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"mom", ",", "i", ",", "\[Kappa]", ",", "j", ",", "randlist"}], 
     "}"}], ",", " ", 
    RowBox[{
     RowBox[{"mom", " ", "=", " ", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "dim"}], "}"}]}], "]"}]}], ";", 
     RowBox[{"randlist", " ", "=", " ", 
      RowBox[{"RandomSample", "[", 
       RowBox[{
        RowBox[{"triplets", "[", 
         RowBox[{"[", 
          RowBox[{"1", ";;", "100"}], "]"}], "]"}], ",", 
        RowBox[{"n", "-", "1"}]}], "]"}]}], ";", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"i", "<=", 
        RowBox[{"n", "-", "1"}]}], ",", 
       RowBox[{"i", "++"}], ",", 
       RowBox[{
        RowBox[{"j", " ", "=", " ", 
         RowBox[{"ReverseSort", "[", 
          RowBox[{"randlist", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ";", 
        RowBox[{
         RowBox[{"mom", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "1"}], "]"}], "]"}], " ", "=", " ", 
         RowBox[{"j", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ";", 
        RowBox[{
         RowBox[{"mom", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", 
            RowBox[{"Mod", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"i", "+", "1"}], ")"}], ",", 
              RowBox[{"dim", "+", "1"}]}], "]"}]}], "]"}], "]"}], " ", "=", 
         " ", 
         RowBox[{"j", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ";", 
        RowBox[{
         RowBox[{"mom", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", 
            RowBox[{"Mod", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"i", "+", "2"}], ")"}], ",", 
              RowBox[{"dim", "+", "1"}]}], "]"}]}], "]"}], "]"}], " ", "=", 
         " ", 
         RowBox[{"j", "[", 
          RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"mom", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "=", 
         RowBox[{"\[CapitalLambda]", ".", 
          RowBox[{"mom", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}]}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"n", "==", "dim"}], ",", 
       RowBox[{
        RowBox[{"mom", "[", 
         RowBox[{"[", 
          RowBox[{"n", "-", "1"}], "]"}], "]"}], " ", "=", " ", 
        RowBox[{"\[Kappa]", "*", 
         RowBox[{"(", 
          RowBox[{"\[CapitalLambda]", ".", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"j", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"j", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"j", "[", 
              RowBox[{"[", "3", "]"}], "]"}], ",", "0", ",", "0", ",", "0"}], 
            "}"}]}], ")"}]}]}], ",", 
       RowBox[{
        RowBox[{"mom", "[", 
         RowBox[{"[", 
          RowBox[{"n", "-", "1"}], "]"}], "]"}], "=", 
        RowBox[{"\[Kappa]", "*", 
         RowBox[{"mom", "[", 
          RowBox[{"[", 
           RowBox[{"n", "-", "1"}], "]"}], "]"}]}]}]}], "]"}], ";", 
     RowBox[{
      RowBox[{"mom", "[", 
       RowBox[{"[", "n", "]"}], "]"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"-", "1"}], "*", 
       RowBox[{"Total", "[", 
        RowBox[{"mom", "[", 
         RowBox[{"[", 
          RowBox[{"1", ";;", 
           RowBox[{"n", "-", "1"}]}], "]"}], "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"mom", "/.", 
      RowBox[{
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"gdot", "[", 
           RowBox[{
            RowBox[{"mom", "[", 
             RowBox[{"[", "n", "]"}], "]"}], ",", 
            RowBox[{"mom", "[", 
             RowBox[{"[", "n", "]"}], "]"}]}], "]"}], "==", "0"}], ",", 
         "\[Kappa]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}]}]}], "]"}]}]], "Input",
