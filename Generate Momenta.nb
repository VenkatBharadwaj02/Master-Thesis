Cell[BoxData[
 RowBox[{
  RowBox[{"mand", "[", "a_List", "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"result", ",", "i", ",", "tmp"}], "}"}], ",", 
    RowBox[{
     RowBox[{"tmp", "=", "0"}], ";", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"i", "<=", 
        RowBox[{
         RowBox[{"Dimensions", "[", "a", "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ",", 
       RowBox[{"i", "++"}], ",", 
       RowBox[{"tmp", "=", 
        RowBox[{"tmp", "+", 
         RowBox[{"mom", "[", 
          RowBox[{"[", 
           RowBox[{"a", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}]}]}]}], "]"}], ";", 
     RowBox[{"result", "=", 
      RowBox[{"gdot", "[", 
       RowBox[{"tmp", ",", "tmp"}], "]"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.989421979777441*^9, 3.9894219802311897`*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"61d07235-b216-aa49-89c3-9f07739f6367"],

Cell[BoxData[
 RowBox[{
  RowBox[{"triplets", "=", 
   RowBox[{"DeleteDuplicates", "[", 
    RowBox[{"Sort", "/@", 
     RowBox[{"Cases", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"CoprimeQ", "[", 
               RowBox[{"m", ",", "n"}], "]"}], "&&", 
              RowBox[{"OddQ", "[", 
               RowBox[{"m", "-", "n"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"m", "^", "2"}], "-", 
                RowBox[{"n", "^", "2"}]}], ",", 
               RowBox[{"2", " ", "m", " ", "n"}], ",", 
               RowBox[{
                RowBox[{"m", "^", "2"}], "+", 
                RowBox[{"n", "^", "2"}]}]}], "}"}], ",", "Nothing"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"m", ",", "2", ",", "50"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"n", ",", "1", ",", 
             RowBox[{"m", "-", "1"}]}], "}"}]}], "]"}], ",", "1"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"_Integer", ",", "_Integer", ",", "_Integer"}], "}"}]}], 
      "]"}]}], "]"}]}], ";"}]], "Input",
