Cell[BoxData[{
 RowBox[{
  RowBox[{"dim", " ", "=", " ", "6"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g", " ", "=", " ", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"ConstantArray", "[", 
     RowBox[{"1", ",", 
      RowBox[{"{", "dim", "}"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
