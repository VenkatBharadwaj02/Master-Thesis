Cell[BoxData[
 RowBox[{
  RowBox[{"GrassmannSort", "[", "vars_List", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"v", "=", "vars"}], ",", 
      RowBox[{"sign", "=", "1"}], ",", "n", ",", "i", ",", "j", ",", "temp", ",",
       "swapped"}], "}"}], ",", 
    RowBox[{
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", "v", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"Union", "[", "v", "]"}], "]"}], "<", "n"}], ",", 
       RowBox[{"Return", "[", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"{", "}"}]}], "}"}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"swapped", "=", "False"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"GIdx", "[", 
              RowBox[{"v", "[", 
               RowBox[{"[", "j", "]"}], "]"}], "]"}], ">", 
             RowBox[{"GIdx", "[", 
              RowBox[{"v", "[", 
               RowBox[{"[", 
                RowBox[{"j", "+", "1"}], "]"}], "]"}], "]"}]}], ",", 
            RowBox[{
             RowBox[{"temp", "=", 
              RowBox[{"v", "[", 
               RowBox[{"[", "j", "]"}], "]"}]}], ";", 
             RowBox[{
              RowBox[{"v", "[", 
               RowBox[{"[", "j", "]"}], "]"}], "=", 
              RowBox[{"v", "[", 
               RowBox[{"[", 
                RowBox[{"j", "+", "1"}], "]"}], "]"}]}], ";", 
             RowBox[{
              RowBox[{"v", "[", 
               RowBox[{"[", 
                RowBox[{"j", "+", "1"}], "]"}], "]"}], "=", "temp"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"sign", "=", 
              RowBox[{"-", "sign"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"swapped", "=", "True"}]}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", 
            RowBox[{"n", "-", "i"}]}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", "swapped"}], ",", 
          RowBox[{"Break", "[", "]"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"sign", ",", "v"}], "}"}]}]}], "]"}]}]], "Input",
