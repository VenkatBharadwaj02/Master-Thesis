Cell[BoxData[{
 RowBox[{
  RowBox[{"DeclareGrassmann", "[", "vars_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "newVars", "}"}], ",", 
    RowBox[{
     RowBox[{"newVars", "=", 
      RowBox[{"Select", "[", 
       RowBox[{"vars", ",", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"MemberQ", "[", 
           RowBox[{"$GrassmannVars", ",", "#"}], "]"}]}], "&"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"$GrassmannVars", "=", 
      RowBox[{"Join", "[", 
       RowBox[{"$GrassmannVars", ",", "newVars"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"$GrassmannOrdering", "=", 
      RowBox[{"AssociationThread", "[", 
       RowBox[{"$GrassmannVars", "->", 
        RowBox[{"Range", "[", 
         RowBox[{"Length", "[", "$GrassmannVars", "]"}], "]"}]}], "]"}]}], ";",
      "\[IndentingNewLine]", "$GrassmannVars"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GIdx", "[", "v_", "]"}], ":=", 
  RowBox[{"Lookup", "[", 
